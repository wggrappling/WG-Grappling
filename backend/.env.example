DATABASE_URL=postgresql://postgres:change-me@localhost:5432/wg_grappling?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DOCUMENT_STORAGE_PATH=./storage/documents
DOCUMENT_MAX_SIZE_MB=10
FINANCIAL_CYCLE_ENABLED=false
FINANCIAL_CYCLE_CRON=0 5 * * *
FINANCIAL_CYCLE_TIME_ZONE=America/Sao_Paulo
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_ACCOUNT_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300
