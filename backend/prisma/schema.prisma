generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  RECEPTION
  TEACHER
  ALUNO
}

model Person {
  id        Int       @id @default(autoincrement())
  name      String
  cpf       String    @unique
  email     String    @unique
  phone     String?
  createdAt DateTime  @default(now())

  students Student[]
  address  Address?
}

model Address {
  id          Int      @id @default(autoincrement())
  personId    Int      @unique
  street      String
  number      String?
  complement  String?
  neighborhood String
  city        String
  state       String
  zipCode     String
  country     String   @default("Brasil")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id])
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      UserRole
  active    Boolean   @default(true)
  sessionVersion Int  @default(0)
  studentId Int?      @unique
  createdAt DateTime  @default(now())

  student          Student? @relation("StudentUser", fields: [studentId], references: [id], onDelete: Restrict)
  classes          Class[]
  uploadedDocuments Document[] @relation("UploadedDocuments")
  graduations       Graduation[] @relation("GrantedGraduations")
  correctedGraduations Graduation[] @relation("CorrectedGraduations")
  cancelledGraduations Graduation[] @relation("CancelledGraduations")
  auditLogs         AuditLog[]
  refundedPayments  Payment[] @relation("RefundedPayments")
  recordedAttendances Attendance[] @relation("RecordedAttendances")
  correctedAttendances Attendance[] @relation("CorrectedAttendances")
}

model AuthRateLimitBucket {
  key             String    @id
  attempts        Int
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, action])
  @@index([userId])
}

enum StudentStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum StudentModalityStatus {
  ACTIVE
  PAUSED
  FINISHED
}

enum StudentClassStatus {
  ACTIVE
  FINISHED
}

enum BeltRank {
  WHITE
  BLUE
  PURPLE
  BROWN
  BLACK
}

enum DocumentType {
  PHOTO
  MEDICAL_CERTIFICATE
  CONTRACT
  CERTIFICATE
  LGPD
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Student {
  id               Int           @id @default(autoincrement())
  personId         Int           @unique
  enrollmentNumber String        @unique
  status           StudentStatus
  joinedAt         DateTime
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  modalities     StudentModality[]
  plans          StudentPlan[]
  attendances    Attendance[]
  studentClasses StudentClass[]
  charges        Charge[]
  responsibles   StudentResponsible[]
  documents      Document[]
  graduations    Graduation[]
  cart           Cart?
  orders         Order[]
  user           User?                 @relation("StudentUser")
  person         Person              @relation(fields: [personId], references: [id])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id                Int           @id @default(autoincrement())
  name              String
  description       String
  salePrice         Decimal
  availableQuantity Int
  status            ProductStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([status, name])
}

model Cart {
  id        Int      @id @default(autoincrement())
  studentId Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  items   CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([cartId])
}

enum OrderStatus {
  PENDING_PAYMENT
}

model Order {
  id        Int         @id @default(autoincrement())
  studentId Int
  subtotal  Decimal
  total     Decimal
  status    OrderStatus @default(PENDING_PAYMENT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  student Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  items   OrderItem[]

  @@index([studentId, createdAt])
}

model OrderItem {
  id               Int      @id @default(autoincrement())
  orderId          Int
  productId        Int
  productName      String
  quantity         Int
  unitPrice        Decimal
  subtotal         Decimal
  createdAt        DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Document {
  id           Int            @id @default(autoincrement())
  studentId    Int
  type         DocumentType
  fileName     String
  originalName String
  mimeType     String
  extension    String
  size         Int
  storagePath  String
  status       DocumentStatus @default(ACTIVE)
  uploadedBy   Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploader User    @relation("UploadedDocuments", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@unique([studentId, fileName, storagePath])
  @@index([studentId, status])
  @@index([studentId, type])
}

model Responsible {
  id          Int      @id @default(autoincrement())
  name        String
  cpf         String   @unique
  email       String?
  phone       String?
  relationship String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students StudentResponsible[]
}

model StudentResponsible {
  id            Int      @id @default(autoincrement())
  studentId     Int
  responsibleId Int
  createdAt     DateTime @default(now())

  student     Student     @relation(fields: [studentId], references: [id])
  responsible Responsible @relation(fields: [responsibleId], references: [id])

  @@unique([studentId, responsibleId])
  @@index([studentId, responsibleId])
}

model Modality {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  description   String
  hasGraduation Boolean
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studentModalities StudentModality[]
  classes           Class[]
  graduations       Graduation[]
  graduationLevels  GraduationLevel[]
}

model GraduationLevel {
  id         Int      @id @default(autoincrement())
  modalityId Int
  code       String
  name       String
  rankOrder  Int
  minDegree  Int?
  maxDegree  Int?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  modality   Modality     @relation(fields: [modalityId], references: [id], onDelete: Restrict)
  graduations Graduation[]

  @@unique([modalityId, code])
  @@unique([modalityId, rankOrder])
  @@index([modalityId, active])
}

enum GraduationStatus {
  ACTIVE
  CANCELLED
  SUPERSEDED
}

model Graduation {
  id Int @id @default(autoincrement())
  studentId Int
  modalityId Int
  belt BeltRank?
  graduationLevelId Int?
  degree Int?
  beltStartedAt DateTime
  graduatedAt DateTime
  notes String?
  graduatedBy Int
  status GraduationStatus @default(ACTIVE)
  correctedBy Int?
  correctedAt DateTime?
  correctionReason String?
  cancelledBy Int?
  cancelledAt DateTime?
  cancellationReason String?
  correctsGraduationId Int? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student Student @relation(fields: [studentId], references: [id])
  modality Modality @relation(fields: [modalityId], references: [id])
  graduationLevel GraduationLevel? @relation(fields: [graduationLevelId], references: [id], onDelete: Restrict)
  actor User @relation("GrantedGraduations", fields: [graduatedBy], references: [id])
  correctedByUser User? @relation("CorrectedGraduations", fields: [correctedBy], references: [id])
  cancelledByUser User? @relation("CancelledGraduations", fields: [cancelledBy], references: [id])
  corrects Graduation? @relation("GraduationCorrections", fields: [correctsGraduationId], references: [id], onDelete: Restrict)
  correctedVersion Graduation? @relation("GraduationCorrections")
  @@index([studentId, graduatedAt])
  @@index([studentId, modalityId, status, graduatedAt])
  @@index([graduationLevelId])
}

model Plan {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  description   String
  price         Decimal
  weeklyClasses Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studentPlans StudentPlan[]
  charges      Charge[]
}

enum StudentPlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
  FINISHED
}

model StudentPlan {
  id           Int               @id @default(autoincrement())
  studentId    Int
  planId       Int
  startDate    DateTime
  endDate      DateTime?
  monthlyPrice Decimal
  billingDay   Int
  status       StudentPlanStatus
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])
}

model Class {
  id            Int      @id @default(autoincrement())
  name          String
  modalityId    Int
  teacherUserId Int
  weekDays      String[]
  startTime     String
  endTime       String
  capacity      Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modality Modality @relation(fields: [modalityId], references: [id])
  teacher  User     @relation(fields: [teacherUserId], references: [id])

  attendances Attendance[]
  studentClasses StudentClass[]
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

model Attendance {
  id             Int              @id @default(autoincrement())
  classId        Int
  studentId      Int
  attendanceDate DateTime
  status         AttendanceStatus
  notes          String?
  recordedBy     Int?
  correctedBy    Int?
  correctedAt    DateTime?
  correctionReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  class   Class   @relation(fields: [classId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  recordedByUser User? @relation("RecordedAttendances", fields: [recordedBy], references: [id], onDelete: Restrict)
  correctedByUser User? @relation("CorrectedAttendances", fields: [correctedBy], references: [id], onDelete: Restrict)

  @@unique([classId, studentId, attendanceDate])
  @@index([classId, studentId, attendanceDate])
  @@index([recordedBy])
  @@index([correctedBy])
}

model StudentClass {
  id        Int                @id @default(autoincrement())
  studentId Int
  classId   Int
  status    StudentClassStatus @default(ACTIVE)
  joinedAt  DateTime            @default(now())
  leftAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@index([studentId, classId])
  @@index([studentId, status])
}

enum ChargeType {
  ENROLLMENT_FEE
  MONTHLY_FEE
  PRIVATE_CLASS
  PRODUCT
  EVENT
  GRADUATION_EXAM
  OTHER
}

enum ChargeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CASH
  TRANSFER
}

model Charge {
  id              Int          @id @default(autoincrement())
  studentId       Int
  planId          Int?
  type            ChargeType
  description     String
  originalAmount  Decimal
  discountAmount  Decimal      @default(0)
  finalAmount     Decimal
  dueDate         DateTime
  referenceMonth  String
  status          ChargeStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  plan    Plan?   @relation(fields: [planId], references: [id])
  payments Payment[]

  @@unique([studentId, type, referenceMonth])
  @@index([studentId, status])
}

model Payment {
  id        Int           @id @default(autoincrement())
  chargeId  Int
  amount    Decimal
  paidAt    DateTime
  method    PaymentMethod
  reference String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  refundedAt DateTime?
  refundReason String?
  refundedBy Int?

  charge Charge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  refundedByUser User? @relation("RefundedPayments", fields: [refundedBy], references: [id], onDelete: Restrict)

  @@index([chargeId, paidAt])
  @@index([chargeId, refundedAt])
  @@index([refundedBy])
}

model StudentModality {
  id         Int                    @id @default(autoincrement())
  studentId  Int
  modalityId Int
  startedAt  DateTime
  status     StudentModalityStatus
  pausedAt   DateTime?
  resumedAt  DateTime?
  finishedAt DateTime?
  notes      String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  student Student  @relation(fields: [studentId], references: [id])
  modality Modality @relation(fields: [modalityId], references: [id])

  @@index([studentId, modalityId])
  @@index([studentId, status])
}
