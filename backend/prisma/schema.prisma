generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  RECEPTION
  TEACHER
}

model Person {
  id        Int       @id @default(autoincrement())
  name      String
  cpf       String    @unique
  email     String    @unique
  phone     String?
  createdAt DateTime  @default(now())

  students Student[]
  address  Address?
}

model Address {
  id          Int      @id @default(autoincrement())
  personId    Int      @unique
  street      String
  number      String?
  complement  String?
  neighborhood String
  city        String
  state       String
  zipCode     String
  country     String   @default("Brasil")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id])
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      UserRole
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  classes          Class[]
  uploadedDocuments Document[] @relation("UploadedDocuments")
}

enum StudentStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum StudentModalityStatus {
  ACTIVE
  PAUSED
  FINISHED
}

enum DocumentType {
  PHOTO
  MEDICAL_CERTIFICATE
  CONTRACT
  CERTIFICATE
  LGPD
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Student {
  id               Int           @id @default(autoincrement())
  personId         Int           @unique
  enrollmentNumber String        @unique
  status           StudentStatus
  joinedAt         DateTime
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  modalities     StudentModality[]
  plans          StudentPlan[]
  attendances    Attendance[]
  studentClasses StudentClass[]
  charges        Charge[]
  responsibles   StudentResponsible[]
  documents      Document[]
  person         Person              @relation(fields: [personId], references: [id])
}

model Document {
  id           Int            @id @default(autoincrement())
  studentId    Int
  type         DocumentType
  fileName     String
  originalName String
  mimeType     String
  extension    String
  size         Int
  storagePath  String
  status       DocumentStatus @default(ACTIVE)
  uploadedBy   Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploader User    @relation("UploadedDocuments", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@unique([studentId, fileName, storagePath])
  @@index([studentId, status])
  @@index([studentId, type])
}

model Responsible {
  id          Int      @id @default(autoincrement())
  name        String
  cpf         String   @unique
  email       String?
  phone       String?
  relationship String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students StudentResponsible[]
}

model StudentResponsible {
  id            Int      @id @default(autoincrement())
  studentId     Int
  responsibleId Int
  createdAt     DateTime @default(now())

  student     Student     @relation(fields: [studentId], references: [id])
  responsible Responsible @relation(fields: [responsibleId], references: [id])

  @@unique([studentId, responsibleId])
  @@index([studentId, responsibleId])
}

model Modality {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  description   String
  hasGraduation Boolean
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studentModalities StudentModality[]
  classes           Class[]
}

model Plan {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  description   String
  price         Decimal
  weeklyClasses Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studentPlans StudentPlan[]
  charges      Charge[]
}

enum StudentPlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
  FINISHED
}

model StudentPlan {
  id           Int               @id @default(autoincrement())
  studentId    Int
  planId       Int
  startDate    DateTime
  endDate      DateTime?
  monthlyPrice Decimal
  billingDay   Int
  status       StudentPlanStatus
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])
}

model Class {
  id            Int      @id @default(autoincrement())
  name          String
  modalityId    Int
  teacherUserId Int
  weekDays      String[]
  startTime     String
  endTime       String
  capacity      Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modality Modality @relation(fields: [modalityId], references: [id])
  teacher  User     @relation(fields: [teacherUserId], references: [id])

  attendances Attendance[]
  studentClasses StudentClass[]
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

model Attendance {
  id             Int              @id @default(autoincrement())
  classId        Int
  studentId      Int
  attendanceDate DateTime
  status         AttendanceStatus
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  class   Class   @relation(fields: [classId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId, attendanceDate])
  @@index([classId, studentId, attendanceDate])
}

model StudentClass {
  id        Int      @id @default(autoincrement())
  studentId Int
  classId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
  @@index([studentId, classId])
}

enum ChargeType {
  ENROLLMENT_FEE
  MONTHLY_FEE
  PRIVATE_CLASS
  PRODUCT
  EVENT
  GRADUATION_EXAM
  OTHER
}

enum ChargeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

model Charge {
  id              Int          @id @default(autoincrement())
  studentId       Int
  planId          Int?
  type            ChargeType
  description     String
  originalAmount  Decimal
  discountAmount  Decimal      @default(0)
  finalAmount     Decimal
  dueDate         DateTime
  referenceMonth  String
  status          ChargeStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  plan    Plan?   @relation(fields: [planId], references: [id])

  @@unique([studentId, type, referenceMonth])
  @@index([studentId, status])
}

model StudentModality {
  id         Int                    @id @default(autoincrement())
  studentId  Int
  modalityId Int
  startedAt  DateTime
  status     StudentModalityStatus
  notes      String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  student Student  @relation(fields: [studentId], references: [id])
  modality Modality @relation(fields: [modalityId], references: [id])

  @@unique([studentId, modalityId])
}
